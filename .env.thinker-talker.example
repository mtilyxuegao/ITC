# =============================================================================
# ITC · Thinker–Talker 编排层环境变量
# 用法: cp .env.thinker-talker.example .env  并按需修改
# =============================================================================

# ---- Talker(小模型 MiniCPM-o duplex,已跑通的 demo gateway)----
# 编排层以 WS 客户端身份连到 gateway,观察草稿/打断,并下发 control.force_speak
TALKER_GATEWAY_WS=ws://localhost:8006/ws
TALKER_SESSION_MODE=full_duplex

# ---- Thinker(大模型 Qwen3.5-35B-A3B,跑在 SGLang)----
# SGLang OpenAI 兼容端点
THINKER_BASE_URL=http://localhost:30000/v1
THINKER_MODEL=Qwen/Qwen3.5-35B-A3B
THINKER_API_KEY=EMPTY
# SGLang 原生 abort 端点(实时取消在飞请求)
THINKER_ABORT_URL=http://localhost:30000/abort_request
THINKER_TEMPERATURE=0.6
THINKER_MAX_TOKENS=512

# ---- 编排策略 ----
# 多久重跑一次 Thinker(秒)。35B-A3B 便宜,可较高频
THINKER_TICK_SECONDS=1.0
# CUT 触发的最低置信(0~1);低于此不打断
CUT_MIN_CONFIDENCE=0.7
# 人 vs AI 打断优先:human_wins | ai_can_override
INTERRUPT_PRIORITY=human_wins
# INJECT 是否需要等自然停顿(true 更礼貌,false 更快)
INJECT_WAIT_FOR_GAP=true

LOG_LEVEL=info
