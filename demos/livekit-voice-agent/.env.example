# LiveKit Voice Agent + Thinker — environment template
# 用法: cp .env.example .env  然后填入你自己的 key
#
# Talker = OpenAI Realtime 模型(一个 key 同时做 STT+LLM+TTS)。
# Thinker = 跑在 vLLM 上的大推理模型(OpenAI 兼容),独立进程/独立 GPU。

# ── Talker (OpenAI Realtime) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── LiveKit server (仅 `agent.py dev` / `start` 需要;`console` 模式不需要) ──
# 用 LiveKit Cloud(免费档)最省事:在 cloud.livekit.io 建 project 后复制这三个值。
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── Thinker (vLLM, OpenAI-compatible) ─────────────────────────────────────
# vLLM 跑在服务器 GPU 2,3:CUDA_VISIBLE_DEVICES=2,3 vllm serve ... --port 8000
THINKER_BASE_URL=http://localhost:8000/v1
THINKER_MODEL=itc-thinker
THINKER_API_KEY=EMPTY
THINKER_BACKEND=vllm
THINKER_TIMEOUT_S=8.0
THINKER_MAX_TOKENS=1024
THINKER_TEMPERATURE=0.6

# ── Escalation behavior ───────────────────────────────────────────────────
ESCALATION_ENABLED=true
# Who decides to wake the Thinker:
#   talker -> the Talker LLM calls the think_deeply tool when it judges it needed (default)
#   auto   -> heuristic keyword classifier auto-escalates
#   off    -> never escalate
ESCALATION_MODE=talker
ESCALATION_MIN_WORDS=12

# ── Web search tool (Thinker) ─────────────────────────────────────────────
SEARCH_ENABLED=true
SEARCH_BACKEND=ddgs            # ddgs (free, no key) | tavily | brave | none
SEARCH_API_KEY=               # required only for tavily/brave
SEARCH_MAX_RESULTS=5

# ── Thinker Activity dashboard (visualization) ────────────────────────────
# Run `python dashboard.py` and open http://localhost:8800 (tunnel if remote).
DASHBOARD_URL=http://localhost:8800
