# =============================================================================
# ITC (Interaction Model 复刻项目) 环境变量示例
# 用法: cp .env.example .env  然后按需修改
# 说明: 本项目同时支持 SGLang 与 vLLM 两套推理后端
# =============================================================================

# -----------------------------------------------------------------------------
# 通用 / 模型配置
# -----------------------------------------------------------------------------
# 推理后端选择: sglang | vllm
INFER_BACKEND=sglang

# 模型权重路径 (本地目录或 HuggingFace 仓库名)
# 注意: 官方 TML-Interaction-Small 权重尚未公开, 此处填你的复刻 checkpoint
MODEL_PATH=/models/itc-interaction-small
# 对外暴露的模型名 (OpenAI 兼容接口里的 model 字段)
SERVED_MODEL_NAME=itc-interaction-small

# HuggingFace 相关 (需要从 HF 拉权重时填写)
HF_TOKEN=
HF_HOME=/data/hf-cache
HF_HUB_ENABLE_HF_TRANSFER=1

# -----------------------------------------------------------------------------
# 硬件 / 并行
# -----------------------------------------------------------------------------
# 可见 GPU
CUDA_VISIBLE_DEVICES=0,1,2,3
# 张量并行度 (276B MoE 建议多卡)
TP_SIZE=4
# 专家并行 / 数据并行 (按需, MoE 场景常用)
EP_SIZE=1
DP_SIZE=1

# -----------------------------------------------------------------------------
# 服务监听
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=30000

# -----------------------------------------------------------------------------
# SGLang 后端参数 (INFER_BACKEND=sglang 时生效)
# -----------------------------------------------------------------------------
# 静态显存占用比例 (0~1), 越大可缓存的 KV 越多
SGLANG_MEM_FRACTION_STATIC=0.85
# 最大运行中请求数
SGLANG_MAX_RUNNING_REQUESTS=256
# 分块预填充大小 (流式 200ms micro-turn 建议较小值以降时延)
SGLANG_CHUNKED_PREFILL_SIZE=2048
# 上下文长度
SGLANG_CONTEXT_LENGTH=32768
# 是否启用 torch.compile
SGLANG_ENABLE_TORCH_COMPILE=false

# -----------------------------------------------------------------------------
# vLLM 后端参数 (INFER_BACKEND=vllm 时生效)
# -----------------------------------------------------------------------------
VLLM_TENSOR_PARALLEL_SIZE=4
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=256
# 启用分块预填充以平滑流式时延
VLLM_ENABLE_CHUNKED_PREFILL=true
# 数据类型
VLLM_DTYPE=bfloat16

# -----------------------------------------------------------------------------
# Interaction Model 流式 (micro-turn) 参数
# -----------------------------------------------------------------------------
# 每个 micro-turn 的时间片 (毫秒), 官方为 200ms
CHUNK_MS=200
# 音频采样率 (Hz)
AUDIO_SAMPLE_RATE=16000
# 视频 patch 大小 (官方按 40x40 切块)
VIDEO_PATCH_SIZE=40
# 单个流式会话最大时长 (秒), 用于回收 GPU 中的持久序列
SESSION_MAX_SECONDS=600

# -----------------------------------------------------------------------------
# 日志 / 可观测
# -----------------------------------------------------------------------------
LOG_LEVEL=info
